generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum AccountStatus {
  PENDING_VERIFICATION
  ACTIVE
  DISABLED
}
model Owner {
  id String @id @default(uuid())
  // Contas já existentes na migração que introduziu este campo recebem a
  // data da própria migração (não a data real de criação, que não foi
  // registrada antes disso) — só afeta o "Conta desde" do painel "Sobre esta
  // conta" (ver server/community.mjs), sem consequência pra login/sessão.
  createdAt DateTime @default(now())
  tokenHash String @unique
  username String? @unique
  email String? @unique
  displayName String?
  avatar String @default("")
  banner String @default("")
  passwordHash String?
  googleId String? @unique
  status AccountStatus @default(ACTIVE)
  failedLoginAttempts Int @default(0)
  lockedUntil DateTime?
  passwordChangedAt DateTime?
  collections Collection[]
  sessions Session[]
  emailVerifications EmailVerification[]
  passwordResets PasswordReset[]
  authEvents AuthEvent[]
  communityPostLikes CommunityPostLike[]
  communityPostSaves CommunityPostSave[]
  communityItemLikes CommunityItemLike[]
  communityItemSaves CommunityItemSave[]
  communityComments CommunityComment[]
  communityCommentLikes CommunityCommentLike[]
  communityCommentSaves CommunityCommentSave[]
  communityCommentReports CommunityCommentReport[]
  communityBlocks CommunityBlock[]
  communityFollows CommunityFollow[]
  communityPostReports CommunityPostReport[]
  communityItemShares CommunityItemShare[]
  communityPostShares CommunityPostShare[]
  bookmarkSaveMarks BookmarkSaveMark[]
  userRelevance UserRelevance?
  savedCollections SavedCollection[]
}
model Session {
  tokenHash String @id
  ownerId String
  owner Owner @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  @@index([ownerId])
}
model EmailVerification {
  tokenHash String @id
  ownerId String
  owner Owner @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  @@index([ownerId])
}
model PasswordReset {
  tokenHash String @id
  ownerId String
  owner Owner @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  @@index([ownerId])
}
// Log de auditoria de segurança (login, bloqueio, troca de senha, etc.) — nunca inclui senha ou tokens.
model AuthEvent {
  id String @id @default(uuid())
  ownerId String?
  owner Owner? @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  eventType String
  ip String?
  userAgent String?
  createdAt DateTime @default(now())
  @@index([ownerId])
  @@index([eventType])
}
model Collection {
  id String @id @default(uuid())
  ownerId String
  owner Owner @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name String @db.VarChar(120)
  description String @default("")
  color String @default("#8b5cf6")
  isPublic Boolean @default(false)
  // Quando a coleção virou pública pela última vez (ver PATCH /api/collections/:id
  // em server/index.mjs) — null enquanto nunca foi pública. Ordena o feed da
  // aba Comunidade (ver GET /api/community/feed em server/community.mjs) por
  // "quando foi publicada", não por createdAt: uma coleção criada há meses e
  // só agora tornada pública deve aparecer no topo do feed, não enterrada pela
  // data de criação original.
  publishedAt DateTime?
  shape String @default("rounded")
  behavior String @default("expansive")
  // Posição na lista "Suas coleções" — igual ao "order" de Bookmark, escrito
  // tanto pelo botão "Ordenar A-Z" quanto por arrastar uma coleção pra outra
  // posição na lista.
  order Int @default(0)
  createdAt DateTime @default(now())
  bookmarks Bookmark[]
  groups BookmarkGroup[]
  // Quem "seguiu" esta coleção salvando-a (inteira ou só alguns links) na
  // Comunidade — ver comentário de SavedCollection. Ausente em toda coleção
  // que nunca foi salva por ninguém (a imensa maioria).
  savedBy SavedCollection[]
  @@index([ownerId])
}
model BookmarkGroup {
  id String @id @default(uuid())
  collectionId String
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  name String @db.VarChar(120)
  color String @default("#8b5cf6")
  description String @default("")
  // Exibe o nome do grupo escrito embaixo do ícone, na grade — desligado por
  // padrão (só o tooltip ao passar o mouse, como já era antes desse campo existir).
  showName Boolean @default(false)
  // Formato da moldura só deste grupo (círculo/quadrado/arredondado); null usa
  // o formato da própria coleção (collection.shape), sem precisar copiar o
  // valor pra cada grupo novo nem ficar sincronizando quando a coleção muda.
  shape String?
  // "tile": ícone único (App Library) — criado ao arrastar um favorito sobre outro.
  // "section": divisória com o nome do grupo e os favoritos visíveis direto —
  // criado ao importar uma pasta aninhada. Fixo desde a criação (não editável).
  display String @default("tile")
  // Visibilidade do grupo (seção OU agrupamento) dentro da própria coleção —
  // só tem efeito quando collection.isPublic também é true: uma coleção
  // pública pode conter seções/agrupamentos privados, que ficam de fora do
  // perfil público e do feed da Comunidade mesmo com a coleção publicada
  // (ver GET /api/public/:id e GET /api/community/feed em server/index.mjs e
  // server/community.mjs, que agora filtram groups por isPublic). Uma
  // coleção privada já esconde tudo por conta própria, então esse campo só
  // importa de fato dentro de coleções públicas. Um favorito sem grupo
  // continua herdando só o isPublic da coleção, como antes.
  isPublic Boolean @default(true)
  // Só pra "tile": a seção onde o agrupamento vive (null = direto na
  // coleção). Agrupar dois favoritos de dentro de uma seção mantém o
  // agrupamento nela, em vez de jogá-lo pra coleção. SetNull: excluir a seção
  // devolve o agrupamento pra coleção, igual aos favoritos soltos dela.
  parentId String?
  parent BookmarkGroup? @relation("GroupNesting", fields: [parentId], references: [id], onDelete: SetNull)
  children BookmarkGroup[] @relation("GroupNesting")
  createdAt DateTime @default(now())
  bookmarks Bookmark[]
  @@index([collectionId])
  @@index([parentId])
}
// Sem campo isPublic próprio de propósito: um favorito não tem visibilidade
// independente da coleção, sempre herda o isPublic dela (ver PATCH
// /api/collections/:id em server/index.mjs, que agora é o único lugar que
// decide visibilidade) — evita o caso de uma coleção pública "publicada
// vazia" porque os itens continuavam marcados como privados por conta
// própria. O servidor deriva a visibilidade de cada favorito a partir de
// collection.isPublic sempre que precisa (ex: filtrar o que aparece no perfil
// público ou no feed da Comunidade), sem guardar um valor redundante que
// pudesse ficar dessincronizado da coleção.
model Bookmark {
  id String @id @default(uuid())
  collectionId String
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  groupId String?
  group BookmarkGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  name String @db.VarChar(120)
  url String
  description String @default("")
  favicon String @default("")
  color String @default("#8b5cf6")
  order Int @default(0)
  // "unknown": ainda não verificado (padrão pra tudo que já existia antes
  // desse campo, e pra favoritos recém-criados até a próxima rodada da
  // rotina). "ok"/"broken": resultado da última verificação — ver
  // server/linkCheck.mjs. Nunca bloqueia nada, só decolore o ícone na grade.
  linkStatus String @default("unknown")
  linkCheckedAt DateTime?
  createdAt DateTime @default(now())
  // Quem salvou este favorito específico de outro dono na aba "Itens Salvos"
  // (ver comentário de SavedCollectionItem) — cascade: some daqui se o
  // próprio favorito for apagado.
  savedInItems SavedCollectionItem[]
  @@index([collectionId])
  @@index([groupId])
}
// Marca "favoritado" num favorito que já é do PRÓPRIO dono — sem isso,
// favoritar o próprio link cairia no caminho de SavedCollection/
// SavedCollectionItem (ver abaixo) em server/index.mjs, que só faz sentido
// pra link de OUTRO dono. bookmarkId sem chave estrangeira: o favorito pode
// já ter sido apagado, ou nem existir como linha de verdade (ex: publicação
// fictícia da Comunidade, ver communityMock.ts).
model BookmarkSaveMark {
  ownerId String
  owner Owner @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  bookmarkId String
  createdAt DateTime @default(now())
  @@id([ownerId, bookmarkId])
  @@index([bookmarkId])
}
// Uma coleção ALHEIA que o dono passou a "seguir" ao salvá-la na Comunidade —
// tanto a coleção inteira (botão "Salvar" da publicação, ver POST
// /api/community/posts/:postId/save em server/community.mjs) quanto só um
// link específico dela (coração de um item no feed, ver POST
// /api/saved-items/:sourceId em server/index.mjs). Ao contrário do
// comportamento antigo (Collection.savedFromCollectionId/Bookmark.savedFromId,
// que copiavam os dados pro dono editar como se fossem seus), isto é só uma
// referência: a aba "Itens Salvos" sempre lê os dados AO VIVO da coleção
// original (nome, descrição, favoritos atuais), e quem salvou não pode
// editá-la — só o dono da coleção original pode. Apagar a coleção original
// (onDelete: Cascade) remove a referência salva junto, já que não há mais
// nada pra mostrar.
model SavedCollection {
  id String @id @default(uuid())
  ownerId String
  owner Owner @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  collectionId String
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  // true quando o dono salvou a coleção INTEIRA: todo favorito ATUAL da
  // coleção original aparece em "Itens Salvos" ao vivo, mesmo os adicionados
  // depois de salvar. false quando só favoritos individuais foram salvos
  // (coração de um link específico no feed) — nesse caso só os marcados em
  // SavedCollectionItem aparecem, mesmo que a coleção original tenha outros
  // links não salvos. Salvar a coleção inteira depois de já ter salvo itens
  // avulsos dela promove o registro pra full = true; desfazer o "Salvar" da
  // publicação inteira volta pra false (sem apagar o registro) quando ainda
  // sobra algum item salvo avulso.
  full Boolean @default(false)
  createdAt DateTime @default(now())
  items SavedCollectionItem[]
  @@unique([ownerId, collectionId])
  @@index([collectionId])
}
// Um link específico salvo dentro de uma SavedCollection parcial (full =
// false) — ignorado quando full = true, já que a coleção inteira aparece
// completa ao vivo nesse caso. onDelete: Cascade nos dois lados: some daqui
// se o dono desfizer o "Salvar" desse link OU se o favorito original for
// apagado pelo dono dele.
model SavedCollectionItem {
  savedCollectionId String
  savedCollection SavedCollection @relation(fields: [savedCollectionId], references: [id], onDelete: Cascade)
  bookmarkId String
  bookmark Bookmark @relation(fields: [bookmarkId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@id([savedCollectionId, bookmarkId])
  @@index([bookmarkId])
}
// Interações do dono com o feed da aba Comunidade (ver server/community.mjs).
// As publicações em si ainda são fixas no frontend (communityMock.ts, sem
// tabela própria) — só curtir/salvar/comentar por um dono real precisa
// sobreviver a troca de navegador/dispositivo, então isso fica no banco em
// vez de localStorage. postId/bookmarkId apontam pros ids fixos dos mocks
// (ex: "p1", "mock-b3"), sem chave estrangeira, porque esse conteúdo não tem
// tabela própria ainda.
model CommunityPostLike {
  ownerId String
  owner Owner @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  postId String
  createdAt DateTime @default(now())
  @@id([ownerId, postId])
  @@index([postId])
}
model CommunityPostSave {
  ownerId String
  owner Owner @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  postId String
  createdAt DateTime @default(now())
  @@id([ownerId, postId])
  @@index([postId])
}
model CommunityItemLike {
  ownerId String
  owner Owner @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  bookmarkId String
  createdAt DateTime @default(now())
  @@id([ownerId, bookmarkId])
  @@index([bookmarkId])
}
model CommunityItemSave {
  ownerId String
  owner Owner @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  bookmarkId String
  createdAt DateTime @default(now())
  @@id([ownerId, bookmarkId])
  @@index([bookmarkId])
}
// Compartilhar (botão de copiar link) de um favorito específico do feed —
// diferente de curtir/salvar, não é um estado ligado/desligado (não existe
// "descompartilhar"): registra no máximo uma vez por dono, só pra contar
// quantas pessoas distintas compartilharam (ver GET /api/community/feed) e
// alimentar a relevância do link uma única vez por dono (ver
// server/relevance.mjs). Cliques repetidos do mesmo dono continuam copiando
// o link normalmente, só não contam de novo.
model CommunityItemShare {
  ownerId String
  owner Owner @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  bookmarkId String
  createdAt DateTime @default(now())
  @@id([ownerId, bookmarkId])
  @@index([bookmarkId])
}
// Mesma ideia de CommunityItemShare, mas pra publicação (coleção) inteira.
model CommunityPostShare {
  ownerId String
  owner Owner @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  postId String
  createdAt DateTime @default(now())
  @@id([ownerId, postId])
  @@index([postId])
}
// Comentários de verdade escritos por donos reais no feed — os comentários
// dos usuários fictícios (ver communityMock.ts) continuam fixos no frontend;
// só o que o próprio visitante escreve é persistido aqui.
model CommunityComment {
  id String @id @default(uuid())
  postId String
  ownerId String
  owner Owner @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  text String @db.VarChar(500)
  createdAt DateTime @default(now())
  @@index([postId])
}
// commentId pode apontar tanto para um comentário fictício ("c1") quanto para
// o id de um CommunityComment real — curtir/salvar funciona igual nos dois casos.
model CommunityCommentLike {
  ownerId String
  owner Owner @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  commentId String
  createdAt DateTime @default(now())
  @@id([ownerId, commentId])
  @@index([commentId])
}
model CommunityCommentSave {
  ownerId String
  owner Owner @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  commentId String
  createdAt DateTime @default(now())
  @@id([ownerId, commentId])
  @@index([commentId])
}
// Denúncia de comentário abusivo — depois de algumas denúncias de donos
// DISTINTOS (ver COMMENT_REPORT_HIDE_THRESHOLD em server/community.mjs), o
// comentário passa a ficar oculto pra todo mundo automaticamente, sem
// depender de uma fila de moderação humana pra conteúdo obviamente abusivo.
// Upsert idempotente: denunciar duas vezes não conta duas vezes.
model CommunityCommentReport {
  ownerId String
  owner Owner @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  commentId String
  createdAt DateTime @default(now())
  @@id([ownerId, commentId])
  @@index([commentId])
}
// Bloquear o autor de um comentário: os comentários dele somem do feed só
// pra quem bloqueou (as outras pessoas continuam vendo normalmente).
// authorId aponta pro id do autor (Owner.id de um comentário real, ou o id
// fixo de um usuário fictício do communityMock.ts), sem chave estrangeira
// pelo mesmo motivo do postId/commentId acima — esse autor pode não ter
// conta real por trás.
model CommunityBlock {
  ownerId String
  owner Owner @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  authorId String
  createdAt DateTime @default(now())
  @@id([ownerId, authorId])
}
// Seguir o autor de uma publicação — só alimenta o cartão de perfil (contagem
// de "seguidores" e o botão Seguir/Seguindo, ver server/community.mjs) e não
// muda o feed em si, já que ele já mostra todo mundo. Mesmo authorId sem
// chave estrangeira das outras tabelas acima: o autor pode ser fictício.
model CommunityFollow {
  ownerId String
  owner Owner @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  authorId String
  createdAt DateTime @default(now())
  @@id([ownerId, authorId])
  @@index([authorId])
}
// Denúncia de PUBLICAÇÃO (distinta de CommunityCommentReport, que é por
// comentário) — mesma lógica de ocultação automática depois de denúncias de
// donos distintos, ver POST_REPORT_HIDE_THRESHOLD em server/community.mjs.
model CommunityPostReport {
  ownerId String
  owner Owner @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  postId String
  createdAt DateTime @default(now())
  @@id([ownerId, postId])
  @@index([postId])
}
// Relevância global de um link — pontuação interna, nunca exposta em nenhuma
// resposta da API (nem devolvida pro dono do link), usada só pelo próprio
// sistema pra decidir o que recomendar/destacar (ex: futura aba Descobrir).
// Tabela separada em vez de coluna em Bookmark de propósito: assim nenhuma
// consulta existente de favoritos (coleções, perfil público, feed da
// Comunidade) precisa de `select` explícito pra não vazar o campo — a
// pontuação simplesmente não está lá. bookmarkId sem chave estrangeira pelo
// mesmo motivo de CommunityItemLike/Save acima: aponta pro id do favorito
// ORIGINAL (nunca de uma cópia dentro de "Itens Salvos", que não é pública e
// portanto não pode ser copiada de novo), que pode já ter sido apagado.
model LinkRelevance {
  bookmarkId String @id
  score Int @default(0)
  updatedAt DateTime @updatedAt
}
// Mesma ideia de LinkRelevance, mas pra uma coleção (publicação) inteira —
// tabela própria pelo mesmo motivo: nenhuma consulta de coleção precisa de
// select explícito pra não vazar a pontuação, ela simplesmente não está lá.
// Alimentada por curtir/salvar/comentar/compartilhar a PUBLICAÇÃO (ver
// server/community.mjs), nunca pelo próprio dono da coleção.
model CollectionRelevance {
  collectionId String @id
  score Int @default(0)
  updatedAt DateTime @updatedAt
}
// Relevância do PRÓPRIO USUÁRIO (dono) — cresce quando ALGUÉM MAIS
// comenta, curte, salva ou compartilha algum link/coleção dele, ou passa a
// segui-lo; nunca pelas próprias interações do dono em conteúdo alheio (ver
// bumpUserRelevance em server/relevance.mjs, sempre chamada com o dono do
// conteúdo afetado, nunca com quem clicou). ownerId aqui É chave estrangeira
// (diferente de bookmarkId/postId acima): um "dono" sempre corresponde a uma
// conta de verdade, então não existe o caso de apontar pra alguém que nunca
// existiu.
model UserRelevance {
  ownerId String @id
  owner Owner @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  score Int @default(0)
  updatedAt DateTime @updatedAt
}
