# URL de conexão com o Postgres local
DATABASE_URL="postgresql://linkable:linkable@localhost:5432/linkable?schema=public"

# URL do Postgres usado pelos testes (tests/*.test.mjs) - separado do DATABASE_URL principal
TEST_DATABASE_URL="postgresql://linkable:linkable@localhost:5432/linkable_test?schema=public"

# Porta do servidor local
PORT=3001

# Client ID do OAuth do Google (Google Cloud Console > Credentials)
GOOGLE_CLIENT_ID=""

# API key do Resend, usada para envio de e-mails (resend.com)
RESEND_API_KEY=""

# Remetente usado nos e-mails enviados pelo Resend
EMAIL_FROM="Linkable <onboarding@resend.dev>"

# URL base do app (usada em links de e-mail, redirects de OAuth, etc.)
APP_URL="http://localhost:3000"

# Opcional: e-mail que recebe os relatos de bug do menu Ajuda (sempre salvos no banco, tabela BugReport)
BUG_REPORT_EMAIL=""
