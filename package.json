{
  "name": "pinicon",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --watch-path=server server/index.mjs\" \"vite\"",
    "dev:web": "vite",
    "dev:api": "node --watch-path=server server/index.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "start": "node server/index.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "google-auth-library": "^11.0.2",
    "icojs": "^1.0.1",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^1.46.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "resend": "^6.28.1",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^10.0.5",
    "prettier": "^3.9.6",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  }
}
